<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebCamRecorderFree"
        x:Class="WebCamRecorderFree.MainWindow"
        mc:Ignorable="d"
        Title="Web Camera Recorder"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="780"
        Background="#0E1116"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7ECF3" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AEB7C4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB7C4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FieldGroupStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,12" />
            <Setter Property="MinWidth" Value="176" />
        </Style>
    </Window.Resources>

    <Grid Loaded="Grid_Loaded" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Surveillance Recorder" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Camera preview, recording controls, storage and split-file options"
                           Foreground="#AEB7C4"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#17202B"
                    BorderBrush="#263241"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <TextBlock Text="Ready" Foreground="#88D498" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#05070A"
                BorderBrush="#263241"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                ClipToBounds="True">
            <Grid>
                <TextBlock Text="Camera preview"
                           Foreground="#596577"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Image x:Name="WebcamPreview"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       SnapsToDevicePixels="True" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#151A22"
                BorderBrush="#263241"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,16"
                Margin="0,18,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Margin="0,0,18,0"
                            VerticalAlignment="Top">
                    <Button x:Name="btnStartRecording"
                            Content="Start"
                            Click="btnStartRecording_Click"
                            Background="#D73F3F"
                            BorderBrush="#EF6B6B"
                            Foreground="#FFFFFF" />
                    <Button x:Name="StopRecording"
                            Content="Stop"
                            Click="StopRecording_Click"
                            Background="#6C3ED8"
                            BorderBrush="#8B68EE"
                            Foreground="#FFFFFF"
                            Margin="10,0,0,0" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="170">
                    <WrapPanel VerticalAlignment="Top">
                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Resolution" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxTargetResolution"
                                      SelectedIndex="0"
                                      SelectionChanged="cmbxTargetResolution_SelectionChanged">
                                <ComboBoxItem Content="640x480" />
                                <ComboBoxItem Content="1280x720" />
                                <ComboBoxItem Content="1920x1080" />
                                <ComboBoxItem Content="3840x2160" />
                                <ComboBoxItem Content="7680x4320" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Split duration" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxSplitIntoFiles"
                                      SelectedIndex="2"
                                      SelectionChanged="cmbxSplitIntoFiles_SelectionChanged">
                                <ComboBoxItem Content="30 minutes" />
                                <ComboBoxItem Content="1 hour" />
                                <ComboBoxItem Content="2 hours" />
                                <ComboBoxItem Content="4 hours" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Compression codec" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxCompressionCodec"
                                      SelectedIndex="0"
                                      SelectionChanged="cmbxCompressionCodec_SelectionChanged">
                                <ComboBoxItem Content="MP4V" />
                                <ComboBoxItem Content="XVID" />
                                <ComboBoxItem Content="H264" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Detection mode" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxDetectionMode"
                                      SelectedIndex="0"
                                      SelectionChanged="cmbxDetectionMode_SelectionChanged">
                                <ComboBoxItem Content="Motion and people" />
                                <ComboBoxItem Content="Motion only" />
                                <ComboBoxItem Content="Continuous recording" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Frame rate" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxTargetFrameRate"
                                      SelectedIndex="1"
                                      SelectionChanged="cmbxTargetFrameRate_SelectionChanged">
                                <ComboBoxItem Content="15 FPS" />
                                <ComboBoxItem Content="30 FPS" />
                                <ComboBoxItem Content="60 FPS" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Timestamp overlay" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxTimestampOverlay"
                                      SelectedIndex="0"
                                      SelectionChanged="cmbxTimestampOverlay_SelectionChanged">
                                <ComboBoxItem Content="On" />
                                <ComboBoxItem Content="Off" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="Motion sensitivity" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="cmbxMotionSensitivity"
                                      SelectedIndex="1"
                                      SelectionChanged="cmbxMotionSensitivity_SelectionChanged">
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Low" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#111820"
                BorderBrush="#263241"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="btnStoragePath"
                        Grid.Column="0"
                        Content="Browse"
                        MinWidth="92"
                        Click="btnStoragePath_Click" />

                <Label Grid.Column="1"
                       Content="Video storage"
                       Margin="14,0,10,0" />

                <Label x:Name="lblVideoStoragePath"
                       Grid.Column="2"
                       Content="Path to store videos"
                       Foreground="#E7ECF3"
                       HorizontalContentAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</Window>
