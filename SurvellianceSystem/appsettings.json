{
  "exclude": [
    "**/bin",
    "**/bower_components",
    "**/jspm_packages",
    "**/node_modules",
    "**/obj",
    "**/platforms"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MyDatabase;Trusted_Connection=True;"
  },
  "SurvellianceSystemConfig": {
    "StoragePath": "",
    "VideoResolution": "640x480",
    "SplitDurationMinutes": 120,
    "CompressionCodec": "MP4V",
    "DetectionMode": "Motion and people",
    "TargetFrameRate": 30,
    "DrawTimestampOverlay": true,
    "MotionSensitivity": "Normal"
  }
}
